# .zshrc - Main Zsh configuration file
# This file loads modular configuration from ~/.zsh/

# Load initial setup (PATH, exports, Powerlevel10k)
[ -f ~/.zsh/00-init.zsh ] && source ~/.zsh/00-init.zsh

# Oh My Zsh configuration
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"

# Plugins
plugins=(git node 1password azure github brew docker dotnet gh helm history kubectl kubectx macos alias-tips)

# Load Oh My Zsh
source $ZSH/oh-my-zsh.sh

# Load Powerlevel10k theme
source $(brew --prefix)/share/powerlevel10k/powerlevel10k.zsh-theme

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# Load syntax highlighting and autosuggestions
source $(brew --prefix)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
source $(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh

# GitHub Copilot aliases
alias copilot="gh copilot"
alias gcs="gh copilot suggest"
alias gce="gh copilot explain"

# Azure CLI completion
autoload bashcompinit && bashcompinit
source $(brew --prefix)/etc/bash_completion.d/az

# NVM (Node Version Manager)
source ~/.nvm/nvm.sh
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm

# Load tool configurations (FZF, Bat, Eza, etc.)
[ -f ~/.zsh/10-tools.zsh ] && source ~/.zsh/10-tools.zsh

# Load custom functions
[ -f ~/.zsh/20-functions.zsh ] && source ~/.zsh/20-functions.zsh

# Load OS-specific configurations
[ -f ~/.zsh/30-os-specific.zsh ] && source ~/.zsh/30-os-specific.zsh

# Load final setup and completions
[ -f ~/.zsh/99-final.zsh ] && source ~/.zsh/99-final.zsh