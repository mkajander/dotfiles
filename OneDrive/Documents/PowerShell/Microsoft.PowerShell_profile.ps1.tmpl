# Microsoft.PowerShell_profile.ps1 - Main PowerShell profile
# This file loads modular configuration from ~/.config/powershell/

Write-Host "Loading profile: $PSCommandPath" -ForegroundColor Cyan

# Load initial setup (PATH, exports, Oh My Posh)
if (Test-Path "$HOME/.config/powershell/00-init.ps1") {
    . "$HOME/.config/powershell/00-init.ps1"
}

# Load tool configurations (FZF, Bat, Eza, etc.)
if (Test-Path "$HOME/.config/powershell/10-tools.ps1") {
    . "$HOME/.config/powershell/10-tools.ps1"
}

